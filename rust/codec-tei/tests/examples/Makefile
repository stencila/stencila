# TEI fixtures for `stencila-codec-tei`
#
# Most fixtures are generated by running GROBID over openly licensed (CC BY)
# PDFs whose JATS is also published, so that each has a JATS counterpart
# (`<name>.jats.xml`) to compare decodes against. Two are samples from the
# GROBID repository itself, which cover older output shapes. See README.md.
#
# To regenerate the GROBID fixtures:
#
#   make grobid-start   # run the pinned GROBID image on port 8070
#   make -B generated   # fetch the PDFs and process each with GROBID
#   make grobid-stop

# The official GROBID image, pinned by digest. The `-crf` variant uses CRF
# models only; `-full` (14.8 GB) adds deep learning models for some fields but
# writes the same TEI.
GROBID_IMAGE := grobid/grobid:0.9.1-crf@sha256:223957791ac2bbe48609dcc58a689b16b60baeae13a8734ef440ae6bfb38f4cd
GROBID_PORT := 8070
GROBID_URL := http://localhost:$(GROBID_PORT)

# The GROBID 0.9.1 release commit, from which the repository samples are fetched
GROBID_COMMIT := 523bb8e97f357e93682dc4eaa6d22faa8b5b93de
GROBID_RAW := https://raw.githubusercontent.com/grobidOrg/grobid/$(GROBID_COMMIT)

GENERATED := elife-94334 pcbi-1011696 pmc-11611909 pmc-11535196

all: generated samples

generated: $(GENERATED:%=%.tei.xml) $(GENERATED:%=%.jats.xml)

samples: grobid-sample1.tei.xml grobid-sample2.tei.xml

grobid-start:
	docker run --rm -d --name stencila-grobid -p $(GROBID_PORT):8070 $(GROBID_IMAGE)
	until curl -sf $(GROBID_URL)/api/isalive > /dev/null; do sleep 2; done

grobid-stop:
	docker stop stencila-grobid

# Full text without consolidation against external services (so the output
# depends only on the PDF and the GROBID version), and with page coordinates
# of figures and formulas
%.tei.xml: pdfs/%.pdf
	curl -sSf --max-time 600 \
		-F input=@$< \
		-F consolidateHeader=0 \
		-F consolidateCitations=0 \
		-F consolidateFunders=0 \
		-F teiCoordinates=figure \
		-F teiCoordinates=formula \
		$(GROBID_URL)/api/processFulltextDocument -o $@

# eLife 94334 v1: many figures, three tables, 68 references
pdfs/elife-94334.pdf:
	mkdir -p pdfs && curl -sSfL https://cdn.elifesciences.org/articles/94334/elife-94334-v1.pdf -o $@
elife-94334.jats.xml:
	curl -sSfL https://raw.githubusercontent.com/elifesciences/elife-article-xml/master/articles/elife-94334-v1.xml -o $@

# PLOS Computational Biology 10.1371/journal.pcbi.1011696: 29 display equations
pdfs/pcbi-%.pdf:
	mkdir -p pdfs && curl -sSfL "https://journals.plos.org/ploscompbiol/article/file?id=10.1371/journal.pcbi.$*&type=printable" -o $@
pcbi-%.jats.xml:
	curl -sSfL "https://journals.plos.org/ploscompbiol/article/file?id=10.1371/journal.pcbi.$*&type=manuscript" -o $@

# Molecular Systems Biology (EMBO Press), from the PMC Open Access bucket,
# which holds the publisher's PDF and JATS of the same version:
#   PMC11611909  10.1038/s44320-024-00073-2  research article with figures and equations
#   PMC11535196  10.1038/s44320-024-00062-5  a short author correction
pdfs/pmc-%.pdf:
	mkdir -p pdfs && curl -sSfL https://pmc-oa-opendata.s3.amazonaws.com/PMC$*.1/PMC$*.1.pdf -o $@
pmc-%.jats.xml:
	curl -sSfL https://pmc-oa-opendata.s3.amazonaws.com/PMC$*.1/PMC$*.1.xml -o $@

# GROBID's own full-text samples (Apache-2.0)
grobid-sample1.tei.xml:
	curl -sSfL $(GROBID_RAW)/grobid-service/src/test/sample/sample1.tei.xml -o $@
grobid-sample2.tei.xml:
	curl -sSfL $(GROBID_RAW)/grobid-core/src/test/resources/xslt/sample2.tei.fulltext.xml -o $@

.PHONY: all generated samples grobid-start grobid-stop
.SECONDARY:
