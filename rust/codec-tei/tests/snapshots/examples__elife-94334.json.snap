      },
      "title": [
        {
          "type": "Text",
          "value": {
            "string": "Sgs1 helicase and two nucleases Dna2 and Exo1 resect DNA double-strand break ends"
          }
        }
      ],
      "isPartOf": {
        "type": "Reference",
