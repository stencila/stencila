      },
      "url": "https://doi.org/10.1016/j.cell.2008.08.037",
      "pageStart": 981,
      "pageEnd": 994,
      "identifiers": [
        {
          "type": "PropertyValue",
          "propertyId": "PMID",
          "value": "18805091"
        }
      ]
    },
    {
      "type": "Reference",
      "id": "b67",
      "workType": "Article",
      "doi": "10.1126/science.1083430",
      "authors": [
        {
          "type": "Person",
          "familyNames": [
            "Zou"
          ],
          "givenNames": [
            "L"
          ]
        },
        {
          "type": "Person",
          "familyNames": [
            "Elledge"
          ],
          "givenNames": [
            "S",
            "J"
          ]
        }
      ],
      "date": {
        "type": "Date",
        "value": "2003"
      },
      "title": [
        {
          "type": "Text",
          "value": {
            "string": "Sensing DNA damage through ATRIP recognition of RPA-ssDNA complexes"
          }
        }
      ],
      "isPartOf": {
        "type": "Reference",
        "workType": "Periodical",
        "title": [
          {
            "type": "Text",
            "value": {
              "string": "Science"
            }
          }
        ],
        "volumeNumber": 300
      },
      "url": "https://doi.org/10.1126/science.1083430",
      "pageStart": 1542,
      "pageEnd": 1548,
