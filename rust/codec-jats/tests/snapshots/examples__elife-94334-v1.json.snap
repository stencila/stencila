                            "string": "."
                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig1-data3-v1.zip"
                },
                {
                  "type": "Supplement",
                  "id": "fig1sdata4",
                  "label": "Figure 1—source data 4.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original files corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
                              "type": "Text",
                              "value": {
                                "string": "Figure 1F"
                              }
                            }
                          ],
                          "target": "#fig1",
                          "jatsRefType": "fig"
                        },
                        {
                          "type": "Text",
                          "value": {
                            "string": "."
                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig1-data4-v1.zip"
                }
              ],
              "content": [
                {
                  "type": "ImageObject",
                  "contentUrl": "elife-94334-fig1-v1.tif",
                  "mediaType": "image/tiff"
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "In both 1-DSB and 2-DSB strains, 4 hr after the induction of DNA damage, >90% of cells arrested at G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M as determined by an adaptation assay ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1B and E"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ") and DAPI staining ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1D and G"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). In agreement, western blot analysis showed that Rad53 was hyperphosphorylated ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1C and F"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), demonstrating that DDC was fully activated in both these strains after DNA damage. By 12–15 hr after the induction of a single persistent DSB, most 1-DSB cells adapted; that is, they escaped the G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest and re-entered mitosis ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1B"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). The timing of Rad53 dephosphorylation following the induction of a single irreparable DSB correlated with the timing of adaptation and escape from the G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1C"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), as previously shown ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib47",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Pellicioli et al., 2001"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ") In contrast, in the 2-DSB strain, over 90% of cells remained permanently arrested in G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M with persistently hyper-phosphorylated Rad53 throughout the 24 hr time course ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 1E–G"
                      }
                    }
                  ],
                  "target": "#fig1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). We leveraged this permanent cell cycle arrest observed in the 2-DSB strain to study how the DNA damage-induced cell cycle arrest is maintained once it had been established."
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Section",
          "id": "s2-2",
          "content": [
            {
              "type": "Heading",
              "level": 2,
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Analysis of checkpoint factors required for checkpoint maintenance"
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "We used the AID system ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib43",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Nishimura et al., 2009"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ") to conditionally deplete DDC proteins after G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest had been established to study the maintenance of cell cycle arrest. To this end, we appended an AID tag with nine copies of the c-MYC epitope tag to the C-terminus of Ddc2, Rad9, Rad24, and Rad53, which are all components of the Mec1 signaling cascade ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib37",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Memisoglu et al., 2019"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib56",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Sweeney et al., 2005"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib8",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "de la Torre-Ruiz et al., 1998"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Hereafter, all AID-tagged proteins will be designated simply as -AID, for example, Ddc2-9xMyc-AID as Ddc2-AID."
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "AID tagging of DDC proteins did not alter the establishment of G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest; however, "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD9-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD24-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", and "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD53-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " strains are hypomorphic and adapted 24 hr after DNA damage in the absence of IAA, while 2-DSB wild-type counterpart cells remained fully arrested ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 1A"
                      }
                    }
                  ],
                  "target": "#fig2s1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). This premature escape from the cell cycle arrest was dependent on the presence of TIR1 ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 1B"
                      }
                    }
                  ],
                  "target": "#fig2s1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ") and is likely due to low levels of IAA as a natural intermediate in amino acid biosynthesis ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib48",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Rao et al., 2010"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). IAA treatment prior to the induction of 2 DSBs in a control strain, which does not contain any AID-tagged proteins, did not alter the prolonged cell cycle arrest following DNA damage ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 2A"
                      }
                    }
                  ],
                  "target": "#fig2s2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), illustrating that IAA treatment by itself does not alter response to DNA damage. However, rapid degradation of Ddc2-AID, Rad9-AID, Rad24-AID, and Rad53-AID by IAA treatment 2 hr prior to the induction of DSBs largely prevented cell cycle arrest as well as DDC signaling, evident from the absence of detectible Rad53 hyperphosphorylation ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 2B–E"
                      }
                    }
                  ],
                  "target": "#fig2s2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). These results underline the importance of Ddc2, Rad9, Rad24, and Rad53 in initiating DDC signaling and cell cycle arrest in response to DNA damage, agreeing with previous reports ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib47",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Pellicioli et al., 2001"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib45",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Paciotti et al., 2000"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib16",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Emili, 1998"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib8",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "de la Torre-Ruiz et al., 1998"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ")."
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "To test whether the DDC proteins are required for the "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "maintenance"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " of the cell cycle arrest following DNA damage, we employed the AID-tagged strains with 2 DSBs and depleted the AID proteins 4 hr "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "after"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " inducing DSBs. In the absence of IAA, "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "DDC2-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD9-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", or "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD24-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " strains all activated the DDC signaling 4 hr after DSB induction, with 89–99% of cells arrested in G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2A–C"
                      }
                    }
                  ],
                  "target": "#fig2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), demonstrating that AID tagging of these proteins did not impair their function. Within 1 hr after IAA treatment, Ddc2-AID, Rad9-AID, or Rad24-AID were all rapidly depleted, which caused a gradual Rad53 dephosphorylation, as detected by western blotting ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2A–C"
                      }
                    }
                  ],
                  "target": "#fig2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Moreover, agreeing with the loss of Rad53 phosphorylation, IAA treatment of DDC-AID strains triggered release from G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest, while the untreated control cells remained fully arrested. DAPI staining of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "DDC2-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " cells after IAA treatment revealed the accumulation of large-budded cells with two distinct DAPI signals, indicating that cells started to progress into anaphase following Ddc2 depletion ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 3A"
                      }
                    }
                  ],
                  "target": "#fig2s3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). These findings illustrate that the upstream DDC factors Ddc2, Rad9, and Rad24 are essential for initiating and sustaining the cell cycle arrest in response to DNA damage."
                  }
                }
              ]
            },
            {
              "type": "Figure",
              "id": "fig2",
              "label": "2",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Checkpoint maintenance requires Ddc2, Rad9, Rad24, and Rad53 activity. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Above: percentage of G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M-arrested cells in a 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "DDC2-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " strain after DNA damage induction in a liquid culture. Cultures were split 4 hr after galactose treatment to induce DNA damage by GAL::HO and treated either with auxin (+IAA) (1 mM) or with ethanol (Ctrl). Data are shown from three independent experiments, with error bars representing standard error of the mean (SEM). The asterisk marks the timepoint when the percentage of large-budded G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M cells returned to pre-damage levels. Below: western blots ran with samples collected at various timepoints during the same time course, probed with α-Rad53, to determine DDC status, and α-Myc, to determine Ddc2-AID-Myc protein abundance and TIR1-Myc as a loading control. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD9-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "C"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD24-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "D"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD53-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "."
                      }
                    }
                  ]
                },
