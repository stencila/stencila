                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "BFA1-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "."
                      }
                    }
                  ]
