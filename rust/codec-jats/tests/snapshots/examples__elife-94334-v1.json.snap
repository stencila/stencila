                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Mad2 is required for permanent arrest in a 2-DSB strain. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
