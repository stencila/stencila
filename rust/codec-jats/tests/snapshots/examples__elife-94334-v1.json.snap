              "address": "United States"
            }
          ],
          "familyNames": [
            "Waterman"
          ],
          "givenNames": [
            "David",
            "P"
          ],
          "jobTitle": "Author"
        },
        {
          "type": "Person",
          "affiliations": [
            {
              "type": "Organization",
              "name": "Brandeis University",
              "address": "United States"
            }
          ],
          "familyNames": [
            "Ashton"
          ],
          "givenNames": [
            "Marissa"
          ],
