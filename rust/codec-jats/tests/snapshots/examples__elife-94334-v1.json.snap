            {
              "type": "Figure",
              "id": "fig2s3",
              "label": "2—figure supplement 3",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Cell cycle profile as determined by budding and DAPI staining in Ddc2-AID and Rad53-AID mutants ±IAA 4 hr after galactose. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Profile of DAPI-stained cells in a 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "DDC2-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " strain after HO induction. Cultures were split 4 hr after Gal-HO induction. Cells were divided based on cell morphology and number of DAPI signals. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD53-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "."
                      }
                    }
                  ]
                }
              ],
              "content": [
                {
                  "type": "ImageObject",
                  "contentUrl": "elife-94334-fig2-figsupp3-v1.tif",
                  "mediaType": "image/tiff"
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Compared to "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "DDC2-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD9-AID,"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " or "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD24-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ", we found that "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD53-AID"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " cells maintained G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest for an additional 4 hr after complete depletion of Rad53 ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2D"
                      }
                    }
                  ],
                  "target": "#fig2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). In contrast to Ddc2-AID depletion, cell cycle analysis by DAPI staining showed that Rad53 depletion led to a more gradual transition into late anaphase ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2—figure supplement 3B"
                      }
                    }
                  ],
                  "target": "#fig2s3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). This delay after the conditional depletion of Rad53 could be due to continued signaling from downstream targets activated by Rad53 kinase, such as Dun1, or from other targets of the Mec1 kinase, downstream of Ddc2, Rad9, and Rad24."
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Section",
          "id": "s2-3",
          "content": [
            {
              "type": "Heading",
              "level": 2,
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Chk1 sustains checkpoint signaling in the absence of Ddc2, Rad9, Rad24, or Rad53"
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Rad53 and Chk1 kinases both contribute to the maintenance of the cell cycle arrest after DNA damage ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib10",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Dotiwala et al., 2007"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib47",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Pellicioli et al., 2001"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Agreeing with previously published reports ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib51",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Sanchez et al., 1999"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), we find that Chk1 is involved in maintaining the permanent arrest following the induction of 2 DSBs. Deletion of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "CHK1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " did not impair the induction of cell cycle arrest ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 3A"
                      }
                    }
                  ],
                  "target": "#fig3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "); however, it inhibited the permanent cell cycle arrest as >95% of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "chk1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "∆ cells adapted by 24 hr ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 3B"
                      }
                    }
                  ],
                  "target": "#fig3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). We then asked whether the delay in cell cycle re-entry observed when Rad53 was degraded was due to Chk1’s independent role in maintaining arrest. To test this, we induced 2 DSBs in "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "RAD53-AID chk1∆"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " cells for 4 hr and then added IAA to deplete Rad53. Compared to the depletion of Rad53-AID alone ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2D"
                      }
                    }
                  ],
                  "target": "#fig2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), the depletion of Rad53-AID in the absence of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "CHK1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " led to a significant decrease in the number of G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M-arrested cells within 1 hr of IAA treatment ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 3C"
                      }
                    }
                  ],
                  "target": "#fig3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). These results suggest that Chk1 functions in conjunction with Rad53 to sustain cell cycle arrest in response to DNA damage."
                  }
                }
              ]
            },
            {
              "type": "Figure",
              "id": "fig3",
              "label": "3",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Chk1 is dispensable for activation of the cell cycle arrest, but essential for its maintenance. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Percentage of G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M cells in a 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " strain following DNA damage. Data are shown from three independent experiments, with error bars representing the standard error of the mean (SEM). Western blot probed with α-Rad53 to determine the status of DDC and α-Myc to determine TIR1-Myc protein abundance. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Adaptation assay with 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "∆ strain. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "C"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Percentage of G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M-arrested cells a 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆ RAD53-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " strain after DNA damage. Cultures were split 4 hr after DSB induction and treated with 1 mM auxin (+IAA) or with ethanol (Ctrl). Data are shown from three independent experiments, with error bars representing the standard error of the mean (SEM). Western blot probed with α-Myc for Rad53-AID and TIR1-Myc as a loading control. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "D"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "C"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆ DDC2-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". Western blot probed with α-Rad53 and α-Myc. α-Rad53 shows both an unphosphorylated protein and multiple phosphorylated species. α-Myc shows Ddc2-AID degradation and TIR1-Myc as a loading control. The asterisk shows when the percentage of large-budded cells returned to pre-damage levels. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "E"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "D"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆ RAD9-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "F"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "D"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆ RAD24-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "."
                      }
                    }
                  ]
