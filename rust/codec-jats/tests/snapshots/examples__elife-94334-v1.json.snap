                  "label": "Figure 1—source data 3.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original membranes corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
                              "type": "Text",
                              "value": {
                                "string": "Figure 1F"
                              }
                            }
                          ],
                          "target": "#fig1",
                          "jatsRefType": "fig"
                        },
                        {
                          "type": "Text",
