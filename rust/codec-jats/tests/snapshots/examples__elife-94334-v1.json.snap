                }
              ]
            },
            {
              "type": "Figure",
              "id": "fig3s1",
              "label": "3—figure supplement 1",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Tel1 is not required for DDC activation or Rad53 phosphorylation. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Adaptation assay for a "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "tel1∆"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " strain. Cultures were grown in YEP-Lac and put on a YEP-Gal plate. 50 G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "1"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " cells were selected to monitor their morphology after 4 and 24 hr on the YEP-Gal plate. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Western blot probing α-Rad53 in a 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "tel1∆"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". α-Pgk1 probed as a loading control."
                      }
                    }
                  ]
                },
                {
                  "type": "Supplement",
                  "id": "fig3s1sdata1",
                  "label": "Figure 3—figure supplement 1—source data 1.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original membranes corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
                              "type": "Text",
                              "value": {
                                "string": "Figure 3—figure supplement 1B"
                              }
                            }
                          ],
                          "target": "#fig3s1",
                          "jatsRefType": "fig"
                        },
                        {
                          "type": "Text",
                          "value": {
                            "string": "."
                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig3-figsupp1-data1-v1.zip"
                },
                {
                  "type": "Supplement",
                  "id": "fig3s1sdata2",
                  "label": "Figure 3—figure supplement 1—source data 2.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original files corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
                              "type": "Text",
                              "value": {
                                "string": "Figure 3—figure supplement 1B"
                              }
                            }
                          ],
                          "target": "#fig3s1",
                          "jatsRefType": "fig"
                        },
                        {
                          "type": "Text",
                          "value": {
                            "string": "."
                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig3-figsupp1-data2-v1.zip"
                }
              ],
              "content": [
                {
                  "type": "ImageObject",
                  "contentUrl": "elife-94334-fig3-figsupp1-v1.tif",
                  "mediaType": "image/tiff"
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "To explore further how Chk1 signaling contributes to the maintenance of DDC-dependent cell cycle arrest, we depleted DDC factors Ddc2-AID, Rad9-AID, or Rad24-AID in "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "chk1∆"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " cells 4 hr after the induction of DSBs. Depletion of these upstream factors in the absence of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "CHK1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " led to a more rapid release from the cell cycle arrest ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 3D–F"
                      }
                    }
                  ],
                  "target": "#fig3",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": ") compared to the depletion of DDC factors alone ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 2A–C"
                      }
                    }
                  ],
                  "target": "#fig2",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Collectively, these findings demonstrate that Chk1 plays a key role in maintaining cell cycle arrest in response to DNA damage."
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Tel1 is thought to play a minor role in response to DSBs as the establishment of DSB-induced cell cycle arrest normally depends entirely on Mec1 ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib11",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Dotiwala et al., 2010"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). However, previous studies have shown that, in addition to Mec1, Tel1 can also target Chk1 for phosphorylation ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib28",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Limbo et al., 2011"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib51",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Sanchez et al., 1999"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Additionally, when the initial 5’ to 3’ end resection of DSB ends is impaired, Tel1 alone can activate the DDC ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib58",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Usui and Petrini, 2007"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). To study how Tel1 contributes to the maintenance of the permanent cell cycle arrest, we deleted "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "TEL1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " in 2-DSB strain. Unlike "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "chk1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "∆ with 2 DSBs, a "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "TEL1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " deletion did not affect either the establishment of the DDC or the maintenance of checkpoint arrest up to 24 hr ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 3—figure supplement 1"
                      }
                    }
                  ],
                  "target": "#fig3s1",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), agreeing with previously published results ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib12",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Dubrana et al., 2007"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Taken together, these data illustrate that DNA damage-dependent cell cycle arrest is initiated by Mec1 branch of the DDC via Ddc2, Rad9 and Rad24, and the cell cycle arrest is largely sustained by the downstream kinases Rad53 and Chk1, with minor contributions from other downstream targets of DDC."
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Section",
          "id": "s2-4",
          "content": [
            {
              "type": "Heading",
              "level": 2,
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Dun1 is required for the initiation but not for the maintenance of cell cycle arrest"
                  }
                }
              ]
            },
            {
              "type": "Paragraph",
              "content": [
                {
                  "type": "Text",
                  "value": {
                    "string": "Our findings show that a small number of cells remain arrested in the absence of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "CHK1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " when Rad53 is depleted. We posited that Rad53 could modulate the expression of other DDC factors, which, in turn, sustain the cell cycle arrest in the absence of Rad53 and Chk1. One candidate protein is Dun1, a Rad53-activated protein kinase that regulates transcription in response to DNA damage ("
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib6",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Chen et al., 2007"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib63",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Yam et al., 2020"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "; "
                  }
                },
                {
                  "type": "Citation",
                  "target": "bib66",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Zhou and Elledge, 1993"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Deleting "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "DUN1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " significantly impaired checkpoint activation: compared to the wild-type control strain, only 60% of "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "DUN1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " cells arrested in G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M 4 hr after the DSB induction, and only 25% remained in G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrest at 7 hr ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 4A"
                      }
                    }
                  ],
                  "target": "#fig4",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "). Additionally, depletion of Dun1-AID 4 hr after damage induction did not cause a significant change in the proportion of G"
                  }
                },
                {
                  "type": "Subscript",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "2"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "/M arrested in these otherwise wild-type cells, nor did it affect Rad53 phosphorylation ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 4B"
                      }
                    }
                  ],
                  "target": "#fig4",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "); however, deleting "
                  }
                },
                {
                  "type": "Emphasis",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "CHK1"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "value": {
                    "string": " triggered an exit from checkpoint arrest following the depletion of Dun1-AID 4 hr after DSB induction ("
                  }
                },
                {
                  "type": "Link",
                  "content": [
                    {
                      "type": "Text",
                      "value": {
                        "string": "Figure 4C"
                      }
                    }
                  ],
                  "target": "#fig4",
                  "jatsRefType": "fig"
                },
                {
                  "type": "Text",
                  "value": {
                    "string": "), further demonstrating the role of Chk1 in checkpoint maintenance. These results suggest that Dun1 is required for the initiation of DDC and concomitant cell cycle arrest but is dispensable for maintenance."
                  }
                }
              ]
            },
            {
              "type": "Figure",
              "id": "fig4",
              "label": "4",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Dun1 is not required for checkpoint maintenance. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Adaptation assay of 50 G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "1"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " cells on a YEP-Gal plate with 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "dun1∆"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M arrest was determined based on cell morphology as shown in "
                      }
                    },
                    {
                      "type": "Link",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Figure 1A"
                          }
                        }
                      ],
                      "target": "#fig1",
                      "jatsRefType": "fig"
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". Data is shown from three trials with standard error of the mean (SEM). Western blot probed with α-Rad53 and α-Myc for TIR1-Myc as a loading control. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Percentage of G"
                      }
                    },
                    {
                      "type": "Subscript",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "/M-arrested cells for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "DUN1-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " after HO induction. Data are shown from three trials with standard error of the mean (SEM). Cultures were split 4 hr after DSB induction; with auxin (1 mM) (+IAA). Western blot probed with α-Rad53 and α-Myc. α-Rad53 shows both an unphosphorylated protein and multiple phosphorylated species. α-Myc shows Dun1-AID degradation and TIR1-Myc as a loading control. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "C"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "chk1∆ DUN1-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". The asterisk marks when the percentage of large-budded cells returned to pre-damage levels."
                      }
                    }
                  ]
                },
                {
                  "type": "Supplement",
                  "id": "fig4sdata1",
                  "label": "Figure 4—source data 1.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original membranes corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
                              "type": "Text",
                              "value": {
                                "string": "Figure 4A"
                              }
                            }
                          ],
                          "target": "#fig4",
                          "jatsRefType": "fig"
                        },
                        {
                          "type": "Text",
                          "value": {
                            "string": "."
                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig4-data1-v1.zip"
                },
                {
                  "type": "Supplement",
                  "id": "fig4sdata2",
                  "label": "Figure 4—source data 2.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
