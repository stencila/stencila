            {
              "type": "Figure",
              "id": "fig2s2",
              "label": "2—figure supplement 2",
              "labelAutomatically": false,
              "caption": [
                {
                  "type": "Paragraph",
                  "content": [
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "AID-tagged checkpoint proteins readily degrade with auxin. "
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": "("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "A"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Morphological profile of a 2-DSB background where 1 mM auxin (IAA) was added 2 hr before DSB induction with galactose. Western blot of a 2-DSB strain probed with α-Rad53. α-Rad53 shows both an unphosphorylated protein and multiple phosphorylated species. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Morphological profile of "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "DDC2-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": " in a 2-DSB background where IAA was added 2 hr before galactose. Western blot probed with α-Rad53 and α-Myc. α-Rad53 shows both an unphosphorylated protein and multiple phosphorylated species. α-Myc shows Ddc2-AID degradation and TIR1-Myc as a loading control. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "C"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD9-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". α-Myc probe shows Rad9-AID degradation with IAA. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "D"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "B"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") for 2-DSB "
                      }
                    },
                    {
                      "type": "Emphasis",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "RAD24-AID"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ". α-Myc probe shows Rad24-AID degradation with IAA. ("
                      }
                    },
                    {
                      "type": "Strong",
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "E"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "value": {
                        "string": ") Same as ("
                      }
                    },
                    {
                      "type": "Strong",
