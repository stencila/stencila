                          }
                        }
                      ]
                    }
                  ],
                  "target": "elife-94334-fig2-data6-v1.zip"
                },
                {
                  "type": "Supplement",
                  "id": "fig2sdata7",
                  "label": "Figure 2—source data 7.",
                  "labelAutomatically": false,
                  "workType": "Dataset",
                  "caption": [
                    {
                      "type": "Heading",
                      "level": 0,
                      "content": [
                        {
                          "type": "Text",
                          "value": {
                            "string": "Original membranes corresponding to "
                          }
                        },
                        {
                          "type": "Link",
                          "content": [
                            {
