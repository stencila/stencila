  <body>
    <p>With no language:</p>
    <code executable="yes">No language</code>
    <p>With language:</p>
    <code executable="yes" language="python"># Some python code&#10;a = 3</code>
    <p>With language and execution mode:</p>
    <code executable="yes" language="js">// Javascript</code>
    <p>With label:</p>
    <code executable="yes"># Chunk 1A<label>1A</label>
    </code>
    <p>Code figure with caption:</p>
    <code executable="yes" language="r" label-type="FigureLabel">plot(y~x)<label>1</label>
      <caption>
        <p>Y against X.</p>
      </caption>
    </code>
    <p>Code table with caption:</p>
    <code executable="yes" language="r" label-type="TableLabel">head(mtcars)<label>1</label>
      <caption>
        <p>Some cars.</p>
      </caption>
    </code>
  </body>
</article>