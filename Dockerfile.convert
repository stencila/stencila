# syntax=docker/dockerfile:1

ARG CONVERT_SERVER_PROFILE=release
ARG STENCILA_CONVERT_SOURCE_COMMIT=development
ARG STENCILA_CONVERT_RUST_VERSION=1.95

# Build the converter backend.
FROM rust:1.99 AS release

ARG STENCILA_CONVERT_SOURCE_COMMIT
ARG STENCILA_CONVERT_RUST_VERSION

WORKDIR /build
COPY . /build

RUN apt-get update \
  && apt-get install -y --no-install-recommends cmake libclang-dev mold \
  && rm -rf /var/lib/apt/lists/*

ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
ENV STENCILA_CONVERT_SOURCE_COMMIT=${STENCILA_CONVERT_SOURCE_COMMIT}
ENV STENCILA_CONVERT_RUST_VERSION=${STENCILA_CONVERT_RUST_VERSION}

RUN --mount=type=cache,id=stencila-convert-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
  --mount=type=cache,id=stencila-convert-cargo-git,target=/usr/local/cargo/git,sharing=locked \
  --mount=type=cache,id=stencila-convert-target,target=/build/target,sharing=locked \
  cargo build --bin stencila-convert-server --release \
  && cp target/release/stencila-convert-server /usr/local/bin/stencila-convert-server

# Reuse a locally compiled binary for faster development deployments. Build it
# first with `cargo build --bin stencila-convert-server`, then set
# `CONVERT_SERVER_PROFILE` to `debug` in the convert worker's Wrangler config.
FROM rust:1.99 AS debug

COPY target/debug/stencila-convert-server /usr/local/bin/stencila-convert-server
RUN strip /usr/local/bin/stencila-convert-server

# Select the release builder by default, or the local debug binary when asked.
FROM ${CONVERT_SERVER_PROFILE} AS convert-server

# Use Ubuntu version compatible with the main CLI image.
FROM ubuntu:24.04

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates pandoc \
  && useradd --create-home --uid 10001 converter \
  && rm -rf /var/lib/apt/lists/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV STENCILA_CONVERT_TIMEOUT_SECONDS=120
ENV STENCILA_CONVERT_MAX_CONCURRENCY=1
ENV STENCILA_CONVERT_MAX_UPLOAD_MB=26

COPY --from=convert-server /usr/local/bin/stencila-convert-server /usr/local/bin/stencila-convert-server

EXPOSE 8080

USER converter

ENTRYPOINT ["stencila-convert-server"]
