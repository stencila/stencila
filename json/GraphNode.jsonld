{
  "@id": "https://stencila.org/GraphNode",
  "name": "GraphNode",
  "license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "@context": {
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "stencila": "https://stencila.org/"
  },
  "@graph": [
    {
      "@id": "stencila:GraphNode",
      "@type": "rdfs:Class",
      "rdfs:label": "GraphNode",
      "rdfs:comment": "A node in a graph.",
      "rdfs:subClassOf": {
        "@id": "stencila:Entity"
      }
    },
    {
      "@id": "stencila:node",
      "@type": "rdfs:Property",
      "rdfs:label": "node",
      "rdfs:comment": "The embedded Stencila node represented by this graph node.",
      "schema:domainIncludes": {
        "@id": "stencila:GraphNode"
      }
    },
    {
      "@id": "stencila:gaps",
      "@type": "rdfs:Property",
      "rdfs:label": "gaps",
      "rdfs:comment": "Sourced limitations; absence means no gaps were reported, not complete coverage.",
      "schema:domainIncludes": [
        {
          "@id": "stencila:Graph"
        },
        {
          "@id": "stencila:GraphEdge"
        },
        {
          "@id": "stencila:GraphEvidence"
        },
        {
          "@id": "stencila:GraphNode"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "stencila:GraphGap"
      }
    },
    {
      "@id": "stencila:evidence",
      "@type": "rdfs:Property",
      "rdfs:label": "evidence",
      "rdfs:comment": "Evidence of this node's events, including events supporting no relationship.",
      "schema:domainIncludes": [
        {
          "@id": "stencila:GraphEdge"
        },
        {
          "@id": "stencila:GraphNode"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "stencila:GraphEvidence"
      }
    }
  ]
}